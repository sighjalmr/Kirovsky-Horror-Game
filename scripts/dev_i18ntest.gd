func _init() -> void:
	var bad := 0
	var cyr := RegEx.create_from_string("[А-Яа-яЁё]")
	for lang: int in [1, 2]:
		Settings.language = lang
		Loc.setup()
		print("== ", Loc.code())
		for s: String in SAMPLES:
			var t := Loc.t(s)
			print(t, "\n--")
			if cyr.search(t):
				bad += 1
				print("!! RUSSIAN LEFT")
	print("FAILED: %d" % bad if bad else "ALL TRANSLATED")
	Loc.shutdown()
	quit(1 if bad else 0)
